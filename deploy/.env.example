# VPS public URL. Do not add a trailing slash.
PUBLIC_BASE_URL=https://asr.pitun.cc
# Set the exact HTTPS origin used by the browser.
ALLOWED_ORIGIN=https://asr.pitun.cc
CONTROL_PLANE_PORT=18080

# Generate each secret independently with: openssl rand -hex 32
BRIDGE_SHARED_SECRET=replace-with-at-least-16-random-characters
CLIENT_ACCESS_TOKEN=replace-with-an-independent-client-access-token
SESSION_TTL_SECONDS=900

# The supported presentation path uses real Agora audio and real SenseVoice.
DEMO_MODE=false

# Required for the real service. The App Certificate stays on the VPS only and
# is used to issue short-lived AccessToken2 credentials.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
RTC_CHANNEL_PREFIX=asr
RTC_CLIENT_UID=1001
RTC_BRIDGE_UID=9001
RTC_TOKEN_TTL_SECONDS=1200
