# VPS public URL. Do not add a trailing slash.
PUBLIC_BASE_URL=https://asr-demo.example.com
# Leave blank for an IP-only mock smoke test. Set the exact HTTPS origin before
# exposing the demo through its real subdomain.
ALLOWED_ORIGIN=
CONTROL_PLANE_PORT=18080

# Generate with: openssl rand -hex 24
BRIDGE_SHARED_SECRET=replace-with-at-least-16-random-characters
SESSION_TTL_SECONDS=900

# `true` gives a zero-credential boss demo. Set false for the real RTC path.
DEMO_MODE=true

# The next values are required only when DEMO_MODE=false.
AGORA_APP_ID=
DEMO_CHANNEL=sensevoice-demo
DEMO_CLIENT_UID=1001
DEMO_BRIDGE_UID=9001
DEMO_CLIENT_RTC_TOKEN=
DEMO_BRIDGE_RTC_TOKEN=
